# Copy to .env and fill in. .env is gitignored - never commit real values.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string
# Use an ABSOLUTE path (sqlite:////full/path/to/instance/dev.db) - a
# relative path here resolves against whatever directory you happen to
# run `flask`/gunicorn from, and fails with "unable to open database
# file" if that's not the repo root.
DATABASE_URL=sqlite:////absolute/path/to/this/repo/instance/dev.db
# Postgres schema prefix - only read when FLASK_ENV=production.
SCHEMA=

# Alpaca (https://alpaca.markets) - used for bars, snapshots, news, and
# options open interest (PCR). Read-only calls only; this app never places
# orders, so a live-trading key is safe to use, but a paper key works too.
API_KEY=
API_SECRET=
BASE_URL=https://paper-api.alpaca.markets

# Falls back to redis://localhost:6379/0 if unset.
REDIS_URL=redis://localhost:6379/0

# Google OAuth app credentials (https://console.cloud.google.com/apis/credentials).
# Not required for local dev - use GET /api/auth/demo_login instead (logs in
# as the seeded Demo user; disabled when FLASK_ENV=production).
CLIENT_ID=
CLIENT_SECRET=

# This backend's own URL - used to build the Google OAuth redirect URI.
SERVER_BASE_URL=http://localhost:5000
# The FRONTEND's URL (not this backend's) - where the browser is redirected
# after login/OAuth completes.
REACT_APP_BASE_URL=http://localhost:3000
